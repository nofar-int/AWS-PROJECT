@Library('jenkins-shared-library') _

pipeline {

    agent { label 'ec2-agent' }

    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            steps {
                sh '''
                  whoami
                  hostname
                  python --version
                  git --version
                '''
            }
        }

        stage('Static Analysis & Tests') {
            parallel {

                /* ===============================
                   PYLINT
                   =============================== */
                stage('PyLint') {
                    steps {
                        sh '''
                          mkdir -p reports/pylint

                          pylint auth-service/*.py backend/*.py \
                            --output-format=html \
                            > reports/pylint/pylint.html || true
                        '''
                    }
                    post {
                        always {
                            publishHTML(target: [
                                reportDir: 'reports/pylint',
                                reportFiles: 'pylint.html',
                                reportName: 'PyLint Report',
                                keepAll: true,
                                alwaysLinkToLastBuild: true
                            ])
                        }
                    }
                }

                /* ===============================
                   PYTEST
                   =============================== */
                stage('PyTest') {
                    steps {
                        sh '''
                          mkdir -p reports/pytest

                          pytest \
                            --junitxml=reports/pytest/junit.xml \
                            --html=reports/pytest/pytest_report.html \
                            --self-contained-html || true
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                  testResults: 'reports/pytest/junit.xml'

                            publishHTML(target: [
                                reportDir: 'reports/pytest',
                                reportFiles: 'pytest_report.html',
                                reportName: 'Pytest HTML Report',
                                keepAll: true,
                                alwaysLinkToLastBuild: true
                            ])
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finished successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
