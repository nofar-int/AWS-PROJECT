@Library('jenkins-shared-library') _

pipeline {

    agent none

    parameters {
        choice(
            name: 'AGENT_TYPE',
            choices: ['ec2'],
            description: 'Select where the pipeline should run'
        )
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {
        SNYK_TOKEN    = credentials('SNYK_TOKEN')
        APP_NAMESPACE = "demo-app"
        AGENT_LABEL   = "ec2-agent"
    }

    stages {

        stage('Checkout') {
            agent { label "${AGENT_LABEL}" }
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            agent { label "${AGENT_LABEL}" }
            steps {
                sh '''
                  echo "🖥 Running on node: ${NODE_NAME}"
                  whoami
                  hostname

                  echo "🔧 Tool versions:"
                  git --version
                  docker --version || true
                  aws --version || true
                  kubectl version --client || true
                  java -version
                '''
            }
        }

        stage('Static Analysis & Tests') {
            parallel {

                stage('Pylint') {
                    agent { label "${AGENT_LABEL}" }
                    steps {
                        sh '''
                          mkdir -p reports/pylint
                          pylint auth-service/*.py backend/*.py || true
                        '''
                    }
                }

                stage('Unit Tests') {
                    agent { label "${AGENT_LABEL}" }
                    steps {
                        sh '''
                          mkdir -p reports
                          pytest --html=reports/unit_test_report.html --self-contained-html || true
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finished successfully on EC2 agent"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}


