@Library('jenkins-shared-library') _

pipeline {

    /* ================= PARAMETERS ================= */
    parameters {
        choice(
            name: 'agentSelector',
            choices: ['ec2', 'kubernetes'],
            description: 'Select which agent to run the pipeline on'
        )
    }

    /* ================= AGENT ================= */
    agent {
        label "${params.agentSelector == 'ec2' ? 'asg' : 'jenkins-agent'}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {
        AWS_REGION = "us-east-1"
        ECR_REGISTRY = "838883895073.dkr.ecr.us-east-1.amazonaws.com"
        ECR_REPO = "aws_project"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        /* ================= CHECKOUT ================= */
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        /* ================= ENV VALIDATION ================= */
        stage('Validate Agent Environment') {
            steps {
                sh '''
                    echo "=== Agent Info ==="
                    hostname
                    whoami
                    docker --version
                    aws --version
                '''
            }
        }

        /* ================= LOGIN TO ECR ================= */
        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                    | docker login --username AWS --password-stdin $ECR_REGISTRY
                '''
            }
        }

        /* ================= BUILD IMAGES ================= */
        stage('Build Docker Images') {
            steps {
                sh '''
                    echo "Building auth-service..."
                    docker build -t auth-service -f auth-service/Dockerfile .

                    echo "Building backend..."
                    docker build -t backend -f backend/Dockerfile .

                    echo "Building jewelry-store..."
                    docker build -t jewelry-store -f jewelry-store/Dockerfile .
                '''
            }
        }

        /* ================= TAG IMAGES ================= */
        stage('Tag Images for ECR') {
            steps {
                sh '''
                    docker tag auth-service $ECR_REGISTRY/$ECR_REPO/auth-service:$IMAGE_TAG
                    docker tag backend $ECR_REGISTRY/$ECR_REPO/backend:$IMAGE_TAG
                    docker tag jewelry-store $ECR_REGISTRY/$ECR_REPO/jewelry-store:$IMAGE_TAG
                '''
            }
        }

        /* ================= PUSH TO ECR ================= */
        stage('Push Images to ECR') {
            steps {
                sh '''
                    docker push $ECR_REGISTRY/$ECR_REPO/auth-service:$IMAGE_TAG
                    docker push $ECR_REGISTRY/$ECR_REPO/backend:$IMAGE_TAG
                    docker push $ECR_REGISTRY/$ECR_REPO/jewelry-store:$IMAGE_TAG
                '''
            }
        }

        /* ================= LOAD TEST (FOR ASG PROOF) ================= */
        stage('Simulate Workload (ASG Trigger)') {
            steps {
                sh '''
                    echo "Simulating workload to trigger ASG scaling..."
                    sleep 30
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Task 2 pipeline completed successfully"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
        failure {
            echo "❌ Pipeline failed – check logs"
        }
        always {
            sh 'docker system prune -af || true'
        }
    }
}
