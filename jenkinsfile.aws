@Library('jenkins-shared-library') _

pipeline {
    agent { label 'asg' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {
        AWS_REGION   = "us-east-1"
        ECR_REGISTRY = "838883895073.dkr.ecr.us-east-1.amazonaws.com"
        ECR_REPO     = "aws_project"
        IMAGE_TAG    = "${BUILD_NUMBER}"
    }

    stages {

        /* ================= CHECKOUT ================= */
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        /* ================= VALIDATE AGENT ================= */
        stage('Validate Agent Environment') {
            steps {
                sh '''
                    echo "=== Agent Info ==="
                    hostname
                    whoami
                    docker --version
                    aws --version
                    node --version
                    python3 --version
                '''
            }
        }

        /* ================= LOGIN TO ECR ================= */
        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} \
                    | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        /* ================= STATIC ANALYSIS ================= */
        stage('Static Analysis & Tests') {
            parallel {

                stage('Pylint') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            sh '''
                                mkdir -p reports/pylint
                                pip install pylint || true
                                pylint auth-service/*.py backend/*.py \
                                    > reports/pylint/pylint_report.txt || true
                            '''
                        }
                    }
                }

                stage('Unit Tests') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            sh '''
                                mkdir -p reports
                                pip install pytest pytest-html || true
                                pytest --html=reports/unit_test_report.html \
                                       --self-contained-html || true
                            '''
                        }
                    }
                }

                stage('Snyk Scan') {
                    steps {
                        withCredentials([string(credentialsId: 'SNYK_TOKEN', variable: 'SNYK_TOKEN')]) {
                            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                                sh '''
                                    echo "Installing Snyk locally..."
                                    npm install snyk --no-save

                                    echo "Authenticating..."
                                    npx snyk auth ${SNYK_TOKEN}

                                    echo "Running Snyk test..."
                                    npx snyk test || true
                                '''
                            }
                        }
                    }
                }
            }
        }

        /* ================= BUILD DOCKER ================= */
        stage('Build Docker Images') {
            parallel {

                stage('Build Auth') {
                    steps {
                        sh '''
                            docker build -t auth-service:${IMAGE_TAG} \
                                -f infra/Dockerfile.auth .
                        '''
                    }
                }

                stage('Build Backend') {
                    steps {
                        sh '''
                            docker build -t backend:${IMAGE_TAG} \
                                -f infra/Dockerfile.backend .
                        '''
                    }
                }

                stage('Build Frontend') {
                    steps {
                        sh '''
                            docker build -t frontend:${IMAGE_TAG} \
                                -f infra/Dockerfile.frontend .
                        '''
                    }
                }
            }
        }

        /* ================= TAG ================= */
        stage('Tag Images for ECR') {
            steps {
                sh '''
                    docker tag auth-service:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${ECR_REPO}:auth-${IMAGE_TAG}

                    docker tag backend:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${ECR_REPO}:backend-${IMAGE_TAG}

                    docker tag frontend:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${ECR_REPO}:frontend-${IMAGE_TAG}
                '''
            }
        }

        /* ================= PUSH ================= */
        stage('Push Images to ECR') {
            steps {
                sh '''
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:auth-${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:backend-${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:frontend-${IMAGE_TAG}
                '''
            }
        }

        /* ================= REPORTS ================= */
        stage('Publish HTML Reports') {
            steps {
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports/pylint',
                    reportFiles: 'pylint_report.txt',
                    reportName: 'Pylint Report'
                ])

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'unit_test_report.html',
                    reportName: 'Unit Test Report'
                ])
            }
        }

        /* ================= ASG WORKLOAD ================= */
        stage('Simulate Workload (ASG Trigger)') {
            steps {
                sh '''
                    echo "Simulating workload..."
                    sleep 15
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        unstable {
            echo "⚠️ Completed with warnings"
        }
        failure {
            echo "❌ Pipeline failed – check logs"
        }
        always {
            sh 'docker system prune -af || true'
        }
    }
}
