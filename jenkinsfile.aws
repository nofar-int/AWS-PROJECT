@Library('jenkins-shared-library') _

pipeline {

    agent none

    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {

        stage('Checkout') {
            agent { label 'ec2-agent' }
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            agent { label 'ec2-agent' }
            steps {
                sh '''
                  echo "Running on node: $NODE_NAME"
                  whoami
                  hostname
                  git --version
                  python --version || true
                  pip --version || true
                '''
            }
        }

        stage('Static Analysis & Tests') {

            parallel {

                stage('Pylint') {
                    agent { label 'ec2-agent' }
                    steps {
                        sh '''
                          mkdir -p reports/pylint
                          pylint auth-service/*.py backend/*.py \
                            --output-format=text \
                            > reports/pylint/pylint.txt || true
                        '''
                    }
                }

                stage('Pytest') {
                    agent { label 'ec2-agent' }
                    steps {
                        sh '''
                          mkdir -p reports/pytest
                          pytest \
                            --junitxml=reports/pytest/junit.xml \
                            --html=reports/pytest/pytest_report.html \
                            --self-contained-html || true
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            node('ec2-agent') {

                echo "📦 Archiving test reports"

                archiveArtifacts artifacts: 'reports/**', fingerprint: true

                publishHTML(target: [
                    reportDir: 'reports/pytest',
                    reportFiles: 'pytest_report.html',
                    reportName: 'Pytest HTML Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: true
                ])

                junit 'reports/pytest/junit.xml'
            }
        }

        success {
            echo "✅ Pipeline finished successfully"
        }

        unstable {
            echo "⚠️ Pipeline finished with warnings"
        }

        failure {
            echo "❌ Pipeline failed"
        }
    }
}

