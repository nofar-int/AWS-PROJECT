@Library('jenkins-shared-library') _

pipeline {

    agent none

    parameters {
        choice(
            name: 'AGENT_TYPE',
            choices: ['ec2'],
            description: 'EC2 agent (Kubernetes will be added later)'
        )
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        timestamps()
    }

    stages {

        stage('Select Agent') {
            steps {
                script {
                    env.AGENT_LABEL = 'ec2-agent'
                }
            }
        }

        stage('Checkout') {
            agent { label "${AGENT_LABEL}" }
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            agent { label "${AGENT_LABEL}" }
            steps {
                sh '''
                  echo "Running on EC2 agent"
                  git --version
                  python --version || true
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finished successfully on EC2 agent"
        }
    }
}
