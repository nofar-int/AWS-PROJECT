@Library('jenkins-shared-library') _

pipeline {

    agent { label 'asg' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        AWS_REGION = "us-east-1"
        AWS_ACCOUNT_ID = "838883895073"
        ECR_REPO = "aws_project"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        SNYK_TOKEN = credentials('SNYK_TOKEN')
    }

    stages {

        /* ================= CHECKOUT ================= */
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        /* ================= VALIDATE AGENT ================= */
        stage('Validate Agent Environment') {
            steps {
                sh '''
                    echo "=== Agent Info ==="
                    hostname
                    whoami
                    docker --version
                    aws --version
                '''
            }
        }

        /* ================= LOGIN TO ECR ================= */
        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} \
                    | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        /* ================= STATIC ANALYSIS ================= */
        stage('Static Analysis & Tests') {
            parallel {

                stage('Pylint') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh '''
                                mkdir -p reports/pylint
                                pylint auth-service/*.py backend/*.py > reports/pylint/pylint_report.txt || true
                            '''
                        }
                    }
                }

                stage('Unit Tests') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh '''
                                mkdir -p reports
                                pytest --html=reports/unit_test_report.html --self-contained-html || true
                            '''
                        }
                    }
                }

                stage('Snyk Scan') {
                    steps {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh '''
                                npm install -g snyk
                                snyk auth ${SNYK_TOKEN}
                                snyk test || true
                            '''
                        }
                    }
                }
            }
        }

        /* ================= BUILD IMAGES ================= */
        stage('Build Docker Images') {
            parallel {

                stage('Build Auth') {
                    steps {
                        sh '''
                            docker build -t auth-service:${IMAGE_TAG} \
                            -f infra/Dockerfile.auth .
                        '''
                    }
                }

                stage('Build Backend') {
                    steps {
                        sh '''
                            docker build -t backend:${IMAGE_TAG} \
                            -f infra/Dockerfile.backend .
                        '''
                    }
                }

                stage('Build Frontend') {
                    steps {
                        sh '''
                            docker build -t frontend:${IMAGE_TAG} \
                            -f infra/Dockerfile.frontend .
                        '''
                    }
                }
            }
        }

        /* ================= TAG IMAGES ================= */
        stage('Tag Images for ECR') {
            steps {
                sh '''
                    docker tag auth-service:${IMAGE_TAG} \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:auth-${IMAGE_TAG}

                    docker tag backend:${IMAGE_TAG} \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:backend-${IMAGE_TAG}

                    docker tag frontend:${IMAGE_TAG} \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:frontend-${IMAGE_TAG}
                '''
            }
        }

        /* ================= PUSH TO ECR ================= */
        stage('Push Images to ECR') {
            steps {
                sh '''
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:auth-${IMAGE_TAG}
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:backend-${IMAGE_TAG}
                    docker push ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}:frontend-${IMAGE_TAG}
                '''
            }
        }

        /* ================= PUBLISH REPORTS ================= */
        stage('Publish HTML Reports') {
            steps {
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports/pylint',
                    reportFiles: 'pylint_report.txt',
                    reportName: 'Pylint Report'
                ])

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'unit_test_report.html',
                    reportName: 'Unit Test Report'
                ])
            }
        }

        /* ================= SIMULATE LOAD (ASG) ================= */
        stage('Simulate Workload (ASG Trigger)') {
            steps {
                sh '''
                    echo "Simulating workload..."
                    sleep 15
                '''
            }
        }
    }

    post {
        always {
            sh 'docker system prune -af || true'
        }
        success {
            echo "✅ Pipeline completed successfully"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
        failure {
            echo "❌ Pipeline failed – check logs"
        }
    }
}
