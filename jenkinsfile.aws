@Library('jenkins-shared-library') _

pipeline {

    /* =========================================
       GLOBAL AGENT
       ========================================= */
    agent { label 'ec2-agent' }

    /* =========================================
       OPTIONS
       ========================================= */
    options {
        timeout(time: 25, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    /* =========================================
       ENV
       ========================================= */
    environment {
        APP_NAMESPACE = "demo-app"
    }

    stages {

        /* =========================================
           CHECKOUT
           ========================================= */
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /* =========================================
           ENV VALIDATION
           ========================================= */
        stage('Prepare Environment') {
            steps {
                sh '''
                  echo "Node: $(hostname)"
                  whoami
                  git --version
                  python --version || true
                  java -version
                '''
            }
        }

        /* =========================================
           TESTS (PARALLEL + REPORTS)
           ========================================= */
        stage('Tests') {
            parallel {

                stage('PyLint') {
                    steps {
                        sh '''
                          mkdir -p reports/pylint
                          pylint auth-service/*.py backend/*.py || true
                        '''
                    }
                }

                stage('PyTest') {
                    steps {
                        sh '''
                          mkdir -p reports

                          pytest \
                            --junitxml=reports/junit.xml \
                            --html=reports/pytest_report.html \
                            --self-contained-html || true
                        '''
                    }
                    post {
                        always {
                            /* ===== JUNIT ===== */
                            junit allowEmptyResults: true,
                                  testResults: 'reports/junit.xml'

                            /* ===== HTML ===== */
                            publishHTML(target: [
                                reportDir: 'reports',
                                reportFiles: 'pytest_report.html',
                                reportName: 'Pytest HTML Report',
                                keepAll: true,
                                alwaysLinkToLastBuild: true
                            ])
                        }
                    }
                }
            }
        }
    }

    /* =========================================
       POST
       ========================================= */
    post {
        success {
            echo "✅ Pipeline finished successfully on EC2 agent"
        }
        failure {
            echo "❌ Pipeline failed"
        }
    }
}
