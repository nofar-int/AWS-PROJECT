@Library('jenkins-shared-library') _

pipeline {
    agent { label 'asg' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    environment {
        AWS_REGION  = "us-east-1"
        AWS_ACCOUNT = "838883895073"
        ECR_REPO    = "aws_project"
        IMAGE_TAG   = "${BUILD_NUMBER}"
    }

    stages {

        /* ================= CHECKOUT ================= */
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        /* ================= VALIDATE AGENT ================= */
        stage('Validate Agent Environment') {
            steps {
                sh '''
                    echo "=== Agent Info ==="
                    hostname
                    whoami
                    docker --version
                    aws --version
                '''
            }
        }

        /* ================= LOGIN TO ECR ================= */
        stage('Login to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                    | docker login --username AWS --password-stdin \
                    $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        /* ================= BUILD IMAGES ================= */
        stage('Build Docker Images') {
            steps {
                sh '''
                    echo "Building auth-service..."
                    docker build -t auth-service:$IMAGE_TAG \
                        -f infra/Dockerfile.auth .

                    echo "Building backend..."
                    docker build -t backend:$IMAGE_TAG \
                        -f infra/Dockerfile.backend .

                    echo "Building jewelry-store..."
                    docker build -t jewelry-store:$IMAGE_TAG \
                        -f infra/Dockerfile.frontend .
                '''
            }
        }

        /* ================= TAG FOR ECR ================= */
        stage('Tag Images for ECR') {
            steps {
                sh '''
                    docker tag auth-service:$IMAGE_TAG \
                        $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:auth-$IMAGE_TAG

                    docker tag backend:$IMAGE_TAG \
                        $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:backend-$IMAGE_TAG

                    docker tag jewelry-store:$IMAGE_TAG \
                        $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:frontend-$IMAGE_TAG
                '''
            }
        }

        /* ================= PUSH TO ECR ================= */
        stage('Push Images to ECR') {
            steps {
                sh '''
                    docker push $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:auth-$IMAGE_TAG
                    docker push $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:backend-$IMAGE_TAG
                    docker push $AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:frontend-$IMAGE_TAG
                '''
            }
        }

        /* ================= SIMULATE LOAD (ASG TEST) ================= */
        stage('Simulate Workload (ASG Trigger)') {
            steps {
                sh '''
                    echo "Simulating workload to verify ASG agent..."
                    sleep 10
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Images built and pushed to ECR successfully"
        }

        failure {
            echo "❌ Pipeline failed – check logs"
        }

        always {
            sh 'docker system prune -af || true'
        }
    }
}
