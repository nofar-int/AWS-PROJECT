@Library('jenkins-shared-library') _

pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent'
            defaultContainer 'tools'
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
    - name: tools
      image: alpine/k8s:1.33.0
      command: ['cat']
      tty: true

    - name: python
      image: python:3.11-slim
      command: ['cat']
      tty: true

    - name: node
      image: node:20
      command: ['cat']
      tty: true

    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ['/busybox/cat']
      tty: true
      volumeMounts:
        - name: kaniko-cache
          mountPath: /cache

  volumes:
    - name: kaniko-cache
      emptyDir: {}
"""
        }
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableResume()
    }

    environment {
        AWS_REGION    = "us-east-1"
        ECR_REGISTRY  = "838883895073.dkr.ecr.us-east-1.amazonaws.com"
        ECR_REPO      = "aws_project"
        APP_NAMESPACE = "nofar-app"
        IMAGE_TAG     = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Validate EKS Agent Environment') {
            steps {
                container('tools') {
                    sh '''
                        echo "=== Agent Info ==="
                        hostname
                        whoami
                        kubectl version --client
                    '''
                }
            }
        }

        stage('Static Analysis - Pylint') {
            steps {
                container('python') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh '''
                            mkdir -p reports/pylint
                            pip install pylint
                            pylint auth-service/*.py backend/*.py > reports/pylint/pylint_report.txt || true
                        '''
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                container('python') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh '''
                            mkdir -p reports
                            pip install pytest pytest-html
                            pytest --html=reports/unit_test_report.html --self-contained-html || true
                        '''
                    }
                }
            }
        }

        stage('Snyk Scan') {
            steps {
                container('node') {
                    withCredentials([string(credentialsId: 'SNYK_TOKEN', variable: 'SNYK_TOKEN')]) {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            sh '''
                                npm install snyk --no-save || true
                                npx snyk auth ${SNYK_TOKEN} || true
                                npx snyk test || true
                            '''
                        }
                    }
                }
            }
        }

        stage('Build & Push Auth Image to ECR') {
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(credentialsId: 'aws-ecr-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                            export AWS_DEFAULT_REGION=${AWS_REGION}

                            /kaniko/executor \
                              --context ${WORKSPACE} \
                              --dockerfile ${WORKSPACE}/infra/Dockerfile.auth \
                              --destination ${ECR_REGISTRY}/${ECR_REPO}:auth-${IMAGE_TAG} \
                              --cache=true
                        '''
                    }
                }
            }
        }

        stage('Build & Push Backend Image to ECR') {
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(credentialsId: 'aws-ecr-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                            export AWS_DEFAULT_REGION=${AWS_REGION}

                            /kaniko/executor \
                              --context ${WORKSPACE} \
                              --dockerfile ${WORKSPACE}/infra/Dockerfile.backend \
                              --destination ${ECR_REGISTRY}/${ECR_REPO}:backend-${IMAGE_TAG} \
                              --cache=true
                        '''
                    }
                }
            }
        }

        stage('Build & Push Frontend Image to ECR') {
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(credentialsId: 'aws-ecr-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        sh '''
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                            export AWS_DEFAULT_REGION=${AWS_REGION}

                            /kaniko/executor \
                              --context ${WORKSPACE} \
                              --dockerfile ${WORKSPACE}/infra/Dockerfile.frontend \
                              --destination ${ECR_REGISTRY}/${ECR_REPO}:frontend-${IMAGE_TAG} \
                              --cache=true
                        '''
                    }
                }
            }
        }

        stage('Update Kubernetes Manifests to ECR Images') {
            steps {
                container('tools') {
                    sh '''
                        sed -i "s|image: .*aws_project:auth.*|image: ${ECR_REGISTRY}/${ECR_REPO}:auth-${IMAGE_TAG}|g" infra/k8s/auth-deployment.yaml
                        sed -i "s|image: .*aws_project:backend.*|image: ${ECR_REGISTRY}/${ECR_REPO}:backend-${IMAGE_TAG}|g" infra/k8s/backend-deployment.yaml
                        sed -i "s|image: .*aws_project:frontend.*|image: ${ECR_REGISTRY}/${ECR_REPO}:frontend-${IMAGE_TAG}|g" infra/k8s/fronted-deployment.yaml

                        grep -R "image:" infra/k8s/*.yaml
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                container('tools') {
                    sh '''
                        kubectl apply -f infra/k8s/auth-deployment.yaml -n ${APP_NAMESPACE}
                        kubectl apply -f infra/k8s/backend-deployment.yaml -n ${APP_NAMESPACE}
                        kubectl apply -f infra/k8s/fronted-deployment.yaml -n ${APP_NAMESPACE}
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                container('tools') {
                    sh '''
                        kubectl get pods -n ${APP_NAMESPACE}
                        kubectl get deploy -n ${APP_NAMESPACE}

                        kubectl rollout status deployment/auth-deployment -n ${APP_NAMESPACE} --timeout=120s
                        kubectl rollout status deployment/backend-deployment -n ${APP_NAMESPACE} --timeout=120s
                        kubectl rollout status deployment/frontend-deployment -n ${APP_NAMESPACE} --timeout=120s
                    '''
                }
            }
        }

        stage('Publish HTML Reports') {
            steps {
                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports/pylint',
                    reportFiles: 'pylint_report.txt',
                    reportName: 'Pylint Report'
                ])

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'reports',
                    reportFiles: 'unit_test_report.html',
                    reportName: 'Unit Test Report'
                ])
            }
        }
    }

    post {
        success {
            echo "✅ EKS pipeline completed successfully"
        }
        unstable {
            echo "⚠️ Pipeline completed with warnings"
        }
        failure {
            echo "❌ Pipeline failed – check logs"
        }
    }
}